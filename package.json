{
  "name": "n8n-nodes-ameise",
  "version": "0.1.0",
  "description": "n8n community node for the Ameise APIs (Panda, Stocks, Customer Archive) by blau direkt",
  "license": "MIT",
  "homepage": "https://github.com/hayBIT/n8n-nodes-ameise#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ameise",
    "blau direkt",
    "insurance"
  ],
  "author": {
    "name": "hayBIT",
    "email": "claude@haybach.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayBIT/n8n-nodes-ameise.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AmeiseApi.credentials.js",
      "dist/credentials/AmeiseOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ameise/Ameise.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
